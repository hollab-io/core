{
    "name": "@hollab/viem-extension",
    "version": "0.0.1",
    "private": true,
    "description": "Integration-ready frontend domain and viem helpers for Hollab",
    "license": "MIT",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "directories": {
        "src": "src"
    },
    "files": [
        "src/*",
        "package.json"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "check-types": "tsc --noEmit -p ./tsconfig.json",
        "clean": "rm -rf dist",
        "format": "prettier --check \"src/**/*.ts\"",
        "format:fix": "prettier --write \"src/**/*.ts\"",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "pnpm lint --fix",
        "test": "vitest run --passWithNoTests",
        "test:cov": "vitest run --coverage"
    }
}

# ── RPC ───────────────────────────────────────────────────────────────────────
ETH_MAINNET_RPC_URL=
ETH_SEPOLIA_RPC_URL=

# ── Verification ──────────────────────────────────────────────────────────────
ETHERSCAN_API_KEY=

# ── ENS (required for mainnet/sepolia) ────────────────────────────────────────
# bytes32 namehash of your domain: cast namehash hollab.eth
ENS_PARENT_NODE=

# ── Deployer key (use encrypted keystore instead when possible) ───────────────
# Setup:  cast wallet import deployer --interactive
# Usage:  forge script ... --account deployer
#
# Fallback for CI only:
# DEPLOYER_PRIVATE_KEY=

# ── Organization creation (optional, have defaults) ───────────────────────────
# ORG_SUBNAME=core
# ORG_PURPOSE=Holacracy on-chain
# TOKEN_NAME=HolToken
# TOKEN_SYMBOL=HOL
# INITIAL_SUPPLY=1000000000000000000000000
# TIMELOCK_DELAY=172800
# VOTING_DELAY=86400
# VOTING_PERIOD=604800
# QUORUM_NUMERATOR=4
# TREASURY_DELAY=86400

# ── Infrastructure address overrides (auto-loaded from deployments/ JSON) ─────
# ORGANIZATION_FACTORY=
# TACTICAL_MEETING_IMPL=
# GOVERNANCE_MEETING_IMPL=
# ACTION_VOTING_IMPL=

{
    "name": "@hollab-io/contracts",
    "version": "0.0.1",
    "private": true,
    "description": "",
    "license": "MIT",
    "author": "Wonderland",
    "type": "module",
    "exports": {
        "./actions": {
            "types": "./generated/index.ts",
            "import": "./generated/index.ts",
            "default": "./generated/index.ts"
        }
    },
    "scripts": {
        "build": "command -v forge >/dev/null 2>&1 && forge build || echo 'forge not found, skipping contracts build'",
        "clean": "rm -rf out && rm -rf cache",
        "deploy:infra:mainnet": "forge script script/DeployInfrastructure.s.sol --tc DeployInfrastructure --rpc-url mainnet --account deployer-ethglo --broadcast --verify --slow -vvvv",
        "deploy:infra:sepolia": "forge script script/DeployInfrastructure.s.sol --tc DeployInfrastructure --rpc-url sepolia --private-key $DOMAIN_OWNER_PRIVATE_KEY --broadcast --verify --slow -vvvv",
        "deploy:local": "forge script script/DeployLocal.s.sol --tc DeployLocal --rpc-url localhost --broadcast -vvv",
        "deploy:org:mainnet": "forge script script/CreateOrganization.s.sol --rpc-url mainnet --account deployer-ethglo --broadcast --verify --slow -vvvv",
        "deploy:org:sepolia": "forge script script/CreateOrganization.s.sol --rpc-url sepolia --account deployer-ethglo --broadcast --verify --slow -vvvv",
        "generate": "wagmi generate",
        "lint": "forge fmt",
        "lint:fix": "forge fmt && pnpm lint:sol-tests --fix && pnpm lint:sol-logic --fix",
        "lint:sol-logic": "solhint -c .solhint.json 'src/**/*.sol'",
        "lint:sol-tests": "solhint -c .solhint.tests.json 'test/**/*.sol'",
        "test": "forge test -vvv",
        "test:cov": "forge coverage --report summary --report lcov --match-path 'test/unit/*' --ir-minimum"
    },
    "lint-staged": {
        "(src|test)*.{js,css,md,ts,sol}": "forge fmt",
        "src/**/*.sol": "pnpm lint:sol-logic",
        "test/**/*.sol": "pnpm lint:sol-tests",
        "package.json": "sort-package-json"
    },
    "dependencies": {
        "@wagmi/cli": "2.10.0"
    },
    "devDependencies": {
        "@openzeppelin/contracts": "^5.0.0",
        "forge-std": "github:foundry-rs/forge-std#semver:1.9.2",
        "solhint-community": "4.0.0"
    }
}

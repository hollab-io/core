# WalletConnect — get a project ID at https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=

# Indexer URL fallback (used when chain-specific override below is empty)
VITE_INDEXER_URL=

# Per-chain indexer overrides
VITE_INDEXER_URL_LOCAL=http://localhost:42069
VITE_INDEXER_URL_SEPOLIA=
VITE_INDEXER_URL_MAINNET=
VITE_INDEXER_URL_0G=

# IPFS gateway used to fetch ContentRef blobs.
# - Production: a public gateway (e.g. https://gateway.pinata.cloud) or
#   your dedicated gateway. Reads go to ${VITE_IPFS_GATEWAY}/ipfs/<cid>.
# - Local dev (no PINATA_JWT on the indexer): point this at the indexer URL,
#   which serves blobs from its local mock under GET /ipfs/:cid.
VITE_IPFS_GATEWAY=http://localhost:42069

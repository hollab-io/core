{
    "name": "ts-turborepo-boilerplate",
    "version": "0.0.1",
    "private": true,
    "description": "Start your next offchain project in seconds",
    "homepage": "https://github.com/defi-wonderland/ts-turborepo-boilerplate#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/defi-wonderland/ts-turborepo-boilerplate.git"
    },
    "license": "MIT",
    "author": "Wonderland",
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "check-types": "turbo run check-types",
        "clean": "turbo run clean",
        "create-package": "./create-package.sh",
        "dev": "turbo run dev",
        "dev:local": "./scripts/dev-local.sh",
        "env:prebuild": "turbo run env:prebuild",
        "format": "turbo run format",
        "format:fix": "turbo run format:fix",
        "preinstall": "npx only-allow pnpm",
        "lint": "turbo run lint",
        "lint:fix": "turbo run lint:fix",
        "prepare": "husky && chmod +x ./create-package.sh",
        "start": "turbo run start",
        "test": "turbo run test",
        "test:cov": "turbo run test:cov",
        "test:integration": "turbo run test:integration"
    },
    "lint-staged": {
        "*": "prettier --write --ignore-unknown",
        "*.js,*.ts,*.json": "eslint --fix",
        "package.json": "sort-package-json"
    },
    "devDependencies": {
        "@commitlint/config-conventional": "19.4.1",
        "@ianvs/prettier-plugin-sort-imports": "4.3.1",
        "@types/node": "20.3.1",
        "@typescript-eslint/eslint-plugin": "7.18.0",
        "@typescript-eslint/parser": "7.18.0",
        "@vitest/coverage-v8": "2.1.9",
        "commitlint": "19.4.1",
        "eslint": "8.57.1",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-prettier": "5.2.1",
        "husky": "9.1.5",
        "lint-staged": "15.2.10",
        "prettier": "3.3.3",
        "sort-package-json": "2.10.1",
        "turbo": "2.1.1",
        "typescript": "5.5.4",
        "vitest": "2.1.9"
    },
    "packageManager": "pnpm@9.7.1+sha256.46f1bbc8f8020aa9869568c387198f1a813f21fb44c82f400e7d1dbde6c70b40",
    "engines": {
        "node": "24"
    },
    "pnpm": {
        "peerDependencyRules": {
            "allowedVersions": {
                "react": "19",
                "utf-8-validate": "6",
                "zod": "4"
            }
        },
        "overrides": {
            "@hono/node-server": "^1.19.14",
            "ajv@>=7.0.0-alpha.0 <8.18.0": "^8.18.0",
            "ajv@<6.14.0": "^6.14.0",
            "axios@>=1.0.0 <1.15.0": "^1.15.0",
            "axios@<0.30.0": "^0.30.3",
            "brace-expansion@>=2.0.0 <2.0.3": "^2.0.3",
            "brace-expansion@<1.1.13": "^1.1.13",
            "drizzle-orm@<0.45.2": "^0.45.2",
            "esbuild@<=0.24.2": "^0.25.0",
            "flatted": "^3.4.2",
            "follow-redirects": "^1.16.0",
            "glob@>=10.2.0 <10.5.0": "^10.5.0",
            "hono@>=4.0.0 <4.12.14": "^4.12.14",
            "js-yaml@>=4.0.0 <4.1.1": "^4.1.1",
            "kysely@<0.28.14": "^0.28.14",
            "lodash": "^4.17.23",
            "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
            "minimatch@>=5.0.0 <5.1.8": "^5.1.8",
            "minimatch@<3.1.4": "^3.1.4",
            "picomatch@<2.3.2": "^2.3.2",
            "rollup@>=4.0.0 <4.59.0": "^4.59.0",
            "use-sync-external-store": "1.4.0",
            "vocs>@hono/node-server": "1.19.5",
            "yaml": "^2.8.3"
        }
    }
}
